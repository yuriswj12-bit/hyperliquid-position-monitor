APP_NAME=Hyperdress.AI
HOST=127.0.0.1
PORT=8000
DATABASE_URL=data/hyperdress.db
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
MONITOR_INTERVAL_SECONDS=15
LIQUIDATION_ALERT_PERCENT=12
POSITION_CHANGE_ALERT_PERCENT=25
ALERT_COOLDOWN_SECONDS=900

# JSON array of wallet addresses.
WATCHED_WALLETS=[]

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, for networks that cannot reach api.telegram.org directly.
# Example: http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

# Optional AI analyst for Telegram natural-language questions.
# Groq is OpenAI-compatible and has a free developer tier.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional. Defaults to TELEGRAM_PROXY_URL when empty.
AI_PROXY_URL=
